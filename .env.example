# ===== Copia este archivo como .env para trabajar en tu computador. En Railway estas variables se cargan en el panel. =====

# Base de datos. Local: SQLite (no instalas nada). Railway: referencia al PostgreSQL del proyecto.
DATABASE_URL=sqlite:///./gymtrack.db
# En Railway pon:  DATABASE_URL=${{Postgres.DATABASE_URL}}

# Clave para firmar los tokens de sesión. OBLIGATORIO cambiarla fuera de tu computador (mínimo 32 caracteres al azar).
JWT_SECRET=cambia-este-secreto

# Direcciones del frontend que pueden llamar a esta API (separadas por coma). En producción NO uses *.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Administrador del catálogo de ejercicios (opcional; se crea al iniciar).
ADMIN_EMAIL=
ADMIN_PASSWORD=

RATE_LIMIT_PER_MINUTE=100

# ===== IA por token (opcional). Si dejas AI_API_KEY vacío, la IA queda apagada y todo lo demás funciona. =====
# anthropic = API de Claude | openai = cualquier API compatible con OpenAI (OpenAI, Gemini modo compatible, Groq...)
AI_PROVIDER=anthropic
AI_API_KEY=
# anthropic: si lo dejas vacío usa un modelo pequeño y barato. openai: es obligatorio.
AI_MODEL=
# Solo para proveedores compatibles con OpenAI distintos de OpenAI. Ej. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=
# Tope de tokens que puede gastar cada respuesta y de propuestas por usuario al día (control de costo).
AI_MAX_OUTPUT_TOKENS=1500
AI_DAILY_LIMIT=10
